#!/usr/bin/env bash
# Anthill PATH shim for `cursor-agent`.
#
# When launched inside cmux with a resumable session id, writes a binding-only
# (plus cheap start/end lifecycle) record to
# `$ANTHILL_CMUXTERM_ROOT/cursor-hook-sessions.json` (default `~/.cmuxterm`).
# Existing cursor-agent launch paths are unchanged unless this script is placed
# ahead of the real binary on PATH.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/anthill-hook-shim-common.sh
source "$SCRIPT_DIR/lib/anthill-hook-shim-common.sh"

PROVIDER="cursor"
REAL_BIN="$(anthill_hook_shim_resolve_bin cursor-agent ANTHILL_CURSOR_AGENT_BIN || true)"
if [[ -z "${REAL_BIN:-}" ]]; then
  echo "anthill-cursor-agent: could not resolve real cursor-agent binary" >&2
  exit 127
fi

SESSION_ID=""
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  arg="${args[$i]}"
  if [[ "$arg" == "--resume" && $((i + 1)) -lt ${#args[@]} ]]; then
    next="${args[$((i + 1))]}"
    if [[ "$next" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]; then
      SESSION_ID="$next"
      break
    fi
  elif [[ "$arg" =~ ^--resume=([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$ ]]; then
    SESSION_ID="${BASH_REMATCH[1]}"
    break
  fi
done

if ! anthill_hook_shim_should_bind || [[ -z "$SESSION_ID" ]]; then
  exec "$REAL_BIN" "$@"
fi

if [[ -t 0 ]]; then
  # A Cursor TUI must own the terminal foreground. A plain asynchronous child
  # receives /dev/null as stdin from this non-interactive wrapper, which makes
  # `cursor-agent agent` fall back to print mode and exit before it can wait for
  # the operator. Job control lets us record the real child pid, foreground it,
  # then synchronously publish its ending through the same hook store.
  set -m
  "$REAL_BIN" "$@" &
  CHILD_PID=$!
  anthill_hook_shim_upsert "$PROVIDER" "$SESSION_ID" "running" "$CHILD_PID" "$REAL_BIN" "$@"
  code=0
  fg %1 || code=$?
  set +m
  anthill_hook_shim_upsert "$PROVIDER" "$SESSION_ID" "ended" "$CHILD_PID" "$REAL_BIN" "$@"
  exit "$code"
fi

"$REAL_BIN" "$@" &
CHILD_PID=$!
anthill_hook_shim_upsert "$PROVIDER" "$SESSION_ID" "running" "$CHILD_PID" "$REAL_BIN" "$@"
code=0
wait "$CHILD_PID" || code=$?
anthill_hook_shim_upsert "$PROVIDER" "$SESSION_ID" "ended" "$CHILD_PID" "$REAL_BIN" "$@"
exit "$code"
